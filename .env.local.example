# Скопируйте этот файл в .env.local и заполните значения.
# Ключ живёт ТОЛЬКО на сервере: он читается в app/api/ai/route.ts
# и никогда не попадает в клиентский бандл.

# Серверный ключ выбранного OpenAI-совместимого провайдера.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# По умолчанию используется OpenAI. Для другого OpenAI-совместимого API
# укажите базовый HTTPS URL провайдера и имя доступной ему модели.
# Например: OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MAX_INPUT_CHARS=6000
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=2400

# Демо-режим без ключа: использует консервативные локальные правила, не LLM.
# AI_MOCK=1
